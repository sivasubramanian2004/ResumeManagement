{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.AspNetCore": "Warning",
          "Microsoft": "Warning"
        }
      }
    },

    "FileSettings": {
      "BasePath": "Uploads/Resumes",
      "MaxFileSizeInMB": 5,
      "AllowedExtensions": [ ".pdf" ]
    },
  

  "AllowedHosts": "*"
}
